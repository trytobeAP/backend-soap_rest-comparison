{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    /* Основные настройки */
    "target": "es2016" /* Версия JS на выходе (Node.js отлично понимает ES2016+) */,
    "module": "commonjs" /* Стандарт модулей (require/module.exports) */,
    "moduleResolution": "node" /* Классический поиск модулей */,

    /* Пути */
    "rootDir": "./src" /* Где лежат исходники */,
    "outDir": "./dist" /* Куда складывать скомпилированный JS */,

    /* Совместимость и удобство */
    "esModuleInterop": true /* Разрешает import express from 'express' */,
    "resolveJsonModule": true /* Разрешает импортировать .json файлы */,
    "skipLibCheck": true /* Ускоряет компиляцию, пропуская проверки внутри node_modules */,
    "forceConsistentCasingInFileNames": true,

    /* Строгость */
    "strict": true /* Включает все строгие проверки типов */
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
